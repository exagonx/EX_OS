        ex_zip_apri;
        ex_zip_quante;
        ex_zip_voce;
        ex_zip_estrai;
        ex_zip_crea;
        ex_zip_aggiungi;
        ex_zip_finisci;
        ex_zip_chiudi;
        ex_zip_errore;
        ex_zip_aggiungi_albero;
        ex_zip_riapri;
        ex_zip_livello;
    local: *;
};
