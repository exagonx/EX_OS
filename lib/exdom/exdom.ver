/* lib/exdom/exdom.ver - what exdom.so offers to programs: everything else stays inside it.
 * The ld version script of the library (voce 105, 19 November 2026); it
 * took the place of the name table of exdom_esporta.c, with the same names.
 * ! A NEW PUBLIC FUNCTION GOES HERE TOO, or programs will not link to it. */
{
    global:
        exdom_quanto_serve;
        exdom_apri;
        exdom_avvolgi;
        exdom_nodo;
        exdom_documento;
        exdom_evento;
        exdom_evento_tasto;
        exdom_perso;
        exdom_troncato;
        exdom_indirizzo;
        exdom_risolutore;
        exdom_geometria;
        exdom_dove_andare;
        exdom_biscotti_metti;
        exdom_biscotti;
        exdom_rete_metti;
        exdom_rete_in_attesa;
        exdom_rete_pompa;
        exdom_rete_persa;
    local: *;
};
