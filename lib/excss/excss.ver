/* lib/excss/excss.ver - what excss.so offers to programs: everything else stays inside it.
 * The ld version script of the library (voce 105, 19 November 2026); it
 * took the place of the name table of excss_esporta.c, with the same names.
 * ! A NEW PUBLIC FUNCTION GOES HERE TOO, or programs will not link to it. */
{
    global:
        css_prepara;
        css_analizza;
        css_calcola;
        css_stile_inline;
        css_stile_vuoto;
        css_colore;
        css_media_larghezza;
        css_segno_lista;
        css_base;
        css_sfondo_url;
    local: *;
};
