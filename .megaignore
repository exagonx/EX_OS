# .megaignore del progetto EX-OS — cio' che MEGAsync NON sincronizza.
#
# ! SOLO CIO' CHE E' DELLA SINGOLA MACCHINA O SI RIGENERA DA SOLO. Tutto il
# resto deve passare fra i due PC (vedi ISTRUZIONI-SECONDO-PROFILO.md, 3.2).
# Sintassi: -:nome  esclude i file e le cartelle con quel nome, dovunque.

# gli oggetti della costruzione di Firefox (decine di GB)
-:exilla-obj
# le cartelle di compilazione della toolchain di UNA macchina
# (cross_build/<macchina>/costruzione-binutils, costruzione-gcc, ...)
-:costruzione-*
# Rust (rustup, nightly, rust-src) di UNA macchina: cross_build/<macchina>/rust-macchina
-:rust-macchina
# i rifiuti di Python e degli editor
-:__pycache__
-:*.swp
-:*.swo
# i permessi locali di Claude Code
-:settings.local.json
