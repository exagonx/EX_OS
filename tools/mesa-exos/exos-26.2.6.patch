diff --git a/src/gallium/winsys/sw/exos/exos_sw_winsys.c b/src/gallium/winsys/sw/exos/exos_sw_winsys.c
new file mode 100644
index 00000000000..86e02861ffe
--- /dev/null
+++ b/src/gallium/winsys/sw/exos/exos_sw_winsys.c
@@ -0,0 +1,141 @@
+/*
+ * Copyright (C) 2026 Graziano Falcone
+ * SPDX-License-Identifier: MIT
+ *
+ * The software winsys of EX-OS (voce 88), after the Haiku one
+ * (winsys/sw/hgl): the same hooks, with every display target in memory
+ * from align_malloc instead of a BBitmap.
+ */
+#include <stdio.h>
+
+#include "util/compiler.h"
+#include "pipe/p_defines.h"
+#include "util/format/u_formats.h"
+#include "util/format/u_format.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+#include "frontend/sw_winsys.h"
+
+#include "exos_sw_winsys.h"
+
+struct exos_displaytarget {
+   enum pipe_format format;
+   unsigned width, height, stride, size;
+   void *data;
+};
+
+static inline struct exos_displaytarget *
+exos_dt(struct sw_displaytarget *dt)
+{
+   return (struct exos_displaytarget *)dt;
+}
+
+static void
+exos_winsys_destroy(struct sw_winsys *winsys)
+{
+   FREE(winsys);
+}
+
+static bool
+exos_is_displaytarget_format_supported(struct sw_winsys *winsys,
+                                       unsigned usage, enum pipe_format format)
+{
+   /* memory holds any format; what ExWin shows is converted at display */
+   return true;
+}
+
+static struct sw_displaytarget *
+exos_displaytarget_create(struct sw_winsys *winsys, unsigned usage,
+                          enum pipe_format format, unsigned width,
+                          unsigned height, unsigned alignment,
+                          const void *front_private, unsigned *stride)
+{
+   struct exos_displaytarget *dt = CALLOC_STRUCT(exos_displaytarget);
+   if (!dt)
+      return NULL;
+
+   dt->format = format;
+   dt->width = width;
+   dt->height = height;
+   dt->stride = align(util_format_get_stride(format, width), alignment);
+   dt->size = dt->stride * util_format_get_nblocksy(format, height);
+   dt->data = align_malloc(dt->size, alignment);
+   if (!dt->data) {
+      FREE(dt);
+      return NULL;
+   }
+   *stride = dt->stride;
+   return (struct sw_displaytarget *)dt;
+}
+
+static void
+exos_displaytarget_destroy(struct sw_winsys *winsys,
+                           struct sw_displaytarget *d)
+{
+   struct exos_displaytarget *dt = exos_dt(d);
+   if (!dt)
+      return;
+   align_free(dt->data);
+   FREE(dt);
+}
+
+static struct sw_displaytarget *
+exos_displaytarget_from_handle(struct sw_winsys *winsys,
+                               const struct pipe_resource *templat,
+                               struct winsys_handle *whandle, unsigned *stride)
+{
+   return NULL;   /* no buffers shared between processes yet */
+}
+
+static bool
+exos_displaytarget_get_handle(struct sw_winsys *winsys,
+                              struct sw_displaytarget *d,
+                              struct winsys_handle *whandle)
+{
+   return false;
+}
+
+static void *
+exos_displaytarget_map(struct sw_winsys *winsys, struct sw_displaytarget *d,
+                       unsigned flags)
+{
+   return exos_dt(d)->data;
+}
+
+static void
+exos_displaytarget_unmap(struct sw_winsys *winsys, struct sw_displaytarget *d)
+{
+}
+
+/* A finished frame: a window surface passes its hook as context_private; a
+ * pbuffer passes nothing, and its pixels stay where glReadPixels reads them. */
+static void
+exos_displaytarget_display(struct sw_winsys *winsys, struct sw_displaytarget *d,
+                           void *context_private, unsigned nboxes,
+                           struct pipe_box *box)
+{
+   struct exos_displaytarget *dt = exos_dt(d);
+   struct exos_sw_presenta *p = (struct exos_sw_presenta *)context_private;
+
+   if (p && p->mostra)
+      p->mostra(p, dt->data, dt->width, dt->height, dt->stride);
+}
+
+struct sw_winsys *
+exos_create_sw_winsys(void)
+{
+   struct sw_winsys *winsys = CALLOC_STRUCT(sw_winsys);
+   if (!winsys)
+      return NULL;
+
+   winsys->destroy = exos_winsys_destroy;
+   winsys->is_displaytarget_format_supported = exos_is_displaytarget_format_supported;
+   winsys->displaytarget_create = exos_displaytarget_create;
+   winsys->displaytarget_from_handle = exos_displaytarget_from_handle;
+   winsys->displaytarget_get_handle = exos_displaytarget_get_handle;
+   winsys->displaytarget_map = exos_displaytarget_map;
+   winsys->displaytarget_unmap = exos_displaytarget_unmap;
+   winsys->displaytarget_display = exos_displaytarget_display;
+   winsys->displaytarget_destroy = exos_displaytarget_destroy;
+   return winsys;
+}
diff --git a/src/gallium/winsys/sw/exos/exos_sw_winsys.h b/src/gallium/winsys/sw/exos/exos_sw_winsys.h
new file mode 100644
index 00000000000..dcec27e8cbe
--- /dev/null
+++ b/src/gallium/winsys/sw/exos/exos_sw_winsys.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright (C) 2026 Graziano Falcone
+ * SPDX-License-Identifier: MIT
+ *
+ * The software winsys of EX-OS (voce 88): every display target is a block
+ * of ordinary memory. A pbuffer is read back with glReadPixels; when EGL
+ * windows come (an ExWin window, through the window server's protocol) the
+ * presentation goes through the hook passed as context_private.
+ */
+#ifndef EXOS_SW_WINSYS_H
+#define EXOS_SW_WINSYS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct sw_winsys;
+
+/* What a window surface gives the winsys to show a finished frame: called
+ * by displaytarget_display with the pixels (B8G8R8A8, top row first). */
+struct exos_sw_presenta {
+   void (*mostra)(struct exos_sw_presenta *p, const void *pixel,
+                  unsigned larghezza, unsigned altezza, unsigned passo);
+};
+
+struct sw_winsys *exos_create_sw_winsys(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/gallium/winsys/sw/exos/meson.build b/src/gallium/winsys/sw/exos/meson.build
