diff --git a/src/egl/drivers/exos/egl_exos.c b/src/egl/drivers/exos/egl_exos.c
new file mode 100644
index 00000000000..7d746b3b5c7
--- /dev/null
+++ b/src/egl/drivers/exos/egl_exos.c
@@ -0,0 +1,500 @@
+/*
+ * Copyright (C) 2026 Graziano Falcone
+ * SPDX-License-Identifier: MIT
+ *
+ * The EGL driver of EX-OS (voce 88), written after the Haiku one
+ * (drivers/haiku/egl_haiku.cpp) in C: a software Gallium screen (softpipe,
+ * later llvmpipe) over the EX-OS winsys (winsys/sw/exos), with the generic
+ * glue of frontends/hgl.
+ *
+ * ! SURFACES IN MEMORY FIRST (the user's choice, 7 November 2026): pbuffers
+ * and surfaceless contexts, which is what WebGL in Firefox needs.
+ *
+ * WINDOWS (voce 88 c, 7 November 2026): EGLNativeWindowType is a
+ * struct exos_egl_finestra * (<exos/egl_exwin.h>): the owner of the ExWin
+ * window says how big it is (misura) and takes each finished frame
+ * (mostra). The frame reaches it through the winsys: hgl passes the
+ * surface's exos_sw_presenta as context_private to flush_frontbuffer, and
+ * winsys/sw/exos calls it. Why the owner and not the server's protocol from
+ * here: see egl_exwin.h.
+ */
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "eglconfig.h"
+#include "eglcontext.h"
+#include "eglcurrent.h"
+#include "egldevice.h"
+#include "egldisplay.h"
+#include "egldriver.h"
+#include "eglimage.h"
+#include "egllog.h"
+#include "eglsurface.h"
+#include "egltypedefs.h"
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "state_tracker/st_context.h"
+#include "util/u_atomic.h"
+#include "mesa/glapi/glapi/glapi.h"
+#include "main/glthread.h"
+
+#include "exos/exos_sw_winsys.h"
+#include <exos/egl_exwin.h>
+#include "hgl_context.h"
+
+#include "target-helpers/inline_sw_helper.h"
+
+_EGL_DRIVER_STANDARD_TYPECASTS(exos_egl)
+
+struct exos_egl_display {
+   int ref_count;
+   struct hgl_display *disp;
+};
+
+struct exos_egl_config {
+   _EGLConfig base;
+};
+
+struct exos_egl_context {
+   _EGLContext base;
+   struct hgl_context *ctx;
+};
+
+struct exos_egl_surface {
+   _EGLSurface base;
+   struct hgl_buffer *fb;
+   struct pipe_fence_handle *throttle_fence;
+   /* a window: the owner's description, and the hook the winsys calls */
+   struct exos_egl_finestra *finestra;
+   struct exos_sw_presenta presenta;
+};
+
+/* --- surfaces ------------------------------------------------------------ */
+
+/* The winsys hands a finished frame here (displaytarget_display): BGRA
+ * bytes in memory are the 0xAARRGGBB words the owner asked for. */
+static void
+exos_window_present(struct exos_sw_presenta *p, const void *pixel,
+                    unsigned larghezza, unsigned altezza, unsigned passo)
+{
+   struct exos_egl_surface *surf =
+      (struct exos_egl_surface *)((char *)p - offsetof(struct exos_egl_surface, presenta));
+   surf->finestra->mostra(surf->finestra, (const unsigned int *)pixel,
+                          larghezza, altezza, passo);
+}
+
+/* The owner's size, now. A size that changed reaches Gallium through the
+ * stamp: the next frame is drawn at the new size (hgl_st_framebuffer_validate). */
+static void
+exos_window_update_size(struct exos_egl_surface *surf)
+{
+   unsigned int w = 0, h = 0;
+
+   surf->finestra->misura(surf->finestra, &w, &h);
+   if (w < 1) w = 1;
+   if (h < 1) h = 1;
+   if (w != surf->fb->newWidth || h != surf->fb->newHeight) {
+      surf->fb->newWidth = w;
+      surf->fb->newHeight = h;
+      surf->base.Width = (EGLint)w;
+      surf->base.Height = (EGLint)h;
+      p_atomic_inc(&surf->fb->base.stamp);
+   }
+}
+
+static _EGLSurface *
+exos_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                           void *native_window, const EGLint *attrib_list)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+   struct exos_egl_finestra *f = (struct exos_egl_finestra *)native_window;
+   struct exos_egl_surface *surf;
+   struct st_visual visual;
+
+   /* ! THE VERSION FIRST: a program built for a later form of the
+    * structure must get an error here, not a call through a field this
+    * libEGL does not know (egl_exwin.h). */
+   if (!f || f->versione != EXOS_EGL_FINESTRA_VERSIONE || !f->misura || !f->mostra) {
+      _eglError(EGL_BAD_NATIVE_WINDOW,
+                "EX-OS: the native window is a struct exos_egl_finestra * "
+                "(<exos/egl_exwin.h>) with versione, misura and mostra");
+      return NULL;
+   }
+   surf = calloc(1, sizeof(*surf));
+   if (!surf) {
+      _eglError(EGL_BAD_ALLOC, "eglCreateWindowSurface");
+      return NULL;
+   }
+   if (!_eglInitSurface(&surf->base, disp, EGL_WINDOW_BIT, conf,
+                        attrib_list, native_window)) {
+      free(surf);
+      return NULL;
+   }
+   surf->finestra = f;
+   surf->presenta.mostra = exos_window_present;
+
+   /* BGRA, not BGRX: the fourth byte is then GL's alpha, never garbage */
+   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_ALPHA | HGL_DEPTH | HGL_STENCIL);
+   surf->fb = hgl_create_st_framebuffer(edpy->disp, &visual, &surf->presenta);
+   if (!surf->fb) {
+      free(surf);
+      _eglError(EGL_BAD_ALLOC, "eglCreateWindowSurface");
+      return NULL;
+   }
+   exos_window_update_size(surf);
+   return &surf->base;
+}
+
+static _EGLSurface *
+exos_create_pixmap_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                           void *native_pixmap, const EGLint *attrib_list)
+{
+   _eglError(EGL_BAD_NATIVE_PIXMAP, "EX-OS: no native pixmaps");
+   return NULL;
+}
+
+static _EGLSurface *
+exos_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                            const EGLint *attrib_list)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+   struct exos_egl_surface *surf = calloc(1, sizeof(*surf));
+   struct st_visual visual;
+
+   if (!surf) {
+      _eglError(EGL_BAD_ALLOC, "eglCreatePbufferSurface");
+      return NULL;
+   }
+   if (!_eglInitSurface(&surf->base, disp, EGL_PBUFFER_BIT, conf,
+                        attrib_list, NULL)) {
+      free(surf);
+      return NULL;
+   }
+
+   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_DEPTH | HGL_STENCIL);
+   surf->fb = hgl_create_st_framebuffer(edpy->disp, &visual, NULL);
+   if (!surf->fb) {
+      free(surf);
+      _eglError(EGL_BAD_ALLOC, "eglCreatePbufferSurface");
+      return NULL;
+   }
+   surf->fb->newWidth = surf->base.Width;
+   surf->fb->newHeight = surf->base.Height;
+   p_atomic_inc(&surf->fb->base.stamp);
+   return &surf->base;
+}
+
+static EGLBoolean
+exos_destroy_surface(_EGLDisplay *disp, _EGLSurface *s)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+
+   if (_eglPutSurface(s)) {
+      struct exos_egl_surface *surf = exos_egl_surface(s);
+      struct pipe_screen *screen = edpy->disp->fscreen->screen;
+      screen->fence_reference(screen, &surf->throttle_fence, NULL);
+      hgl_destroy_st_framebuffer(surf->fb);
+      free(surf);
+   }
+   return EGL_TRUE;
+}
+
+/* A pbuffer has no front to show: eglSwapBuffers on it flushes the
+ * rendering, so that glReadPixels and the other context see it, and
+ * returns. (EGL 1.5: "has no effect" on a pbuffer, which is what the core
+ * does before calling here for anything but a window.) */
+static EGLBoolean
+exos_swap_buffers(_EGLDisplay *disp, _EGLSurface *s)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+   struct exos_egl_surface *surf = exos_egl_surface(s);
+   struct exos_egl_context *ectx = exos_egl_context(s->CurrentContext);
+   struct pipe_fence_handle *new_fence = NULL;
+   struct pipe_screen *screen;
+   struct st_context *st;
+
+   if (ectx == NULL)
+      return EGL_FALSE;
+   st = ectx->ctx->st;
+   screen = edpy->disp->fscreen->screen;
+
+   if (surf->finestra && surf->fb->textures[ST_ATTACHMENT_BACK_LEFT])
+      st->pipe->flush_resource(st->pipe, surf->fb->textures[ST_ATTACHMENT_BACK_LEFT]);
+   _mesa_glthread_finish(st->ctx);
+   st_context_flush(st, ST_FLUSH_FRONT, &new_fence, NULL, NULL);
+   if (surf->throttle_fence) {
+      screen->fence_finish(screen, NULL, surf->throttle_fence, OS_TIMEOUT_INFINITE);
+      screen->fence_reference(screen, &surf->throttle_fence, NULL);
+   }
+   surf->throttle_fence = new_fence;
+
+   /* a window: the back buffer goes to the owner (flush_frontbuffer ->
+    * winsys display -> exos_window_present), then front and back swap, as
+    * in the Haiku driver; then the owner's size, for the next frame */
+   if (surf->finestra) {
+      struct hgl_buffer *buffer = surf->fb;
+      struct pipe_resource **front = &buffer->textures[ST_ATTACHMENT_FRONT_LEFT];
+      struct pipe_resource **back = &buffer->textures[ST_ATTACHMENT_BACK_LEFT];
+
+      if (*back) {
+         struct pipe_resource *t;
+         screen->flush_frontbuffer(screen, st->pipe, *back, 0, 0,
+                                   buffer->winsysContext, 0, NULL);
+         t = *front; *front = *back; *back = t;
+         p_atomic_inc(&buffer->base.stamp);
+      }
+      exos_window_update_size(surf);
+   }
+   st_context_invalidate_state(st, ST_INVALIDATE_FB_STATE);
+   return EGL_TRUE;
+}
+
+/* --- display ------------------------------------------------------------- */
+
+/* Two configs: RGBA8 with depth 24 and stencil 8, and the same without
+ * depth and stencil (what a 2D canvas or a video frame asks for). */
+static void
+exos_add_config(_EGLDisplay *disp, int id, int depth, int stencil)
+{
+   struct exos_egl_config *conf = calloc(1, sizeof(*conf));
+   if (!conf)
+      return;
+
+   _eglInitConfig(&conf->base, disp, id);
+   conf->base.RedSize = 8;
+   conf->base.GreenSize = 8;
+   conf->base.BlueSize = 8;
+   conf->base.AlphaSize = 8;
+   conf->base.BufferSize = 32;
+   conf->base.ColorBufferType = EGL_RGB_BUFFER;
+   conf->base.ConfigCaveat = EGL_NONE;
+   conf->base.ConfigID = id;
+   conf->base.DepthSize = depth;
+   conf->base.StencilSize = stencil;
+   conf->base.TransparentType = EGL_NONE;
+   conf->base.NativeRenderable = EGL_FALSE;
+   conf->base.NativeVisualType = EGL_NONE;
+   conf->base.RenderableType = EGL_OPENGL_BIT | EGL_OPENGL_ES_BIT |
+                               EGL_OPENGL_ES2_BIT | EGL_OPENGL_ES3_BIT_KHR;
+   conf->base.Conformant = conf->base.RenderableType;
+   conf->base.MaxPbufferWidth = _EGL_MAX_PBUFFER_WIDTH;
+   conf->base.MaxPbufferHeight = _EGL_MAX_PBUFFER_HEIGHT;
+   /* ! WINDOWS ONLY ON THE EXOS PLATFORM (7 November 2026). The core refuses
+    * any window on a surfaceless or device display (EGL_BAD_NATIVE_WINDOW,
+    * eglapi.c, as the EGL_MESA_platform_surfaceless spec says), so a config
+    * offering one there would promise what eglCreateWindowSurface denies.
+    * Until the exos platform existed EGL_DEFAULT_DISPLAY was surfaceless
+    * and every ExWin window failed that way. */
+   conf->base.SurfaceType = EGL_PBUFFER_BIT;
+   if (disp->Platform == _EGL_PLATFORM_EXOS)
+      conf->base.SurfaceType |= EGL_WINDOW_BIT;
+
+   if (!_eglValidateConfig(&conf->base, EGL_FALSE)) {
+      _eglLog(_EGL_WARNING, "EX-OS: config %d does not validate", id);
+      free(conf);
+      return;
+   }
+   _eglLinkConfig(&conf->base);
+}
+
+static void
+exos_display_destroy(_EGLDisplay *disp)
+{
+   struct exos_egl_display *edpy;
+   struct pipe_screen *screen;
+
+   if (!disp || !disp->DriverData)
+      return;
+   edpy = exos_egl_display(disp);
+   if (!p_atomic_dec_zero(&edpy->ref_count))
+      return;
+
+   screen = edpy->disp->fscreen->screen;
+   hgl_destroy_display(edpy->disp);
+   screen->destroy(screen);
+   free(edpy);
+   disp->DriverData = NULL;
+}
+
+static EGLBoolean
+exos_initialize_impl(_EGLDisplay *disp)
+{
+   struct exos_egl_display *edpy = calloc(1, sizeof(*edpy));
+   struct sw_winsys *winsys;
+   struct pipe_screen *screen;
+
+   if (!edpy)
+      return _eglError(EGL_BAD_ALLOC, "eglInitialize");
+
+   winsys = exos_create_sw_winsys();
+   screen = winsys ? sw_screen_create(winsys) : NULL;
+   if (!screen) {
+      if (winsys)
+         winsys->destroy(winsys);
+      free(edpy);
+      return _eglError(EGL_NOT_INITIALIZED, "EX-OS: no software Gallium screen");
+   }
+   edpy->ref_count = 1;
+   edpy->disp = hgl_create_display(screen);
+   disp->DriverData = edpy;
+
+   disp->ClientAPIs = 0;
+   if (_eglIsApiValid(EGL_OPENGL_API))
+      disp->ClientAPIs |= EGL_OPENGL_BIT;
+   if (_eglIsApiValid(EGL_OPENGL_ES_API))
+      disp->ClientAPIs |= EGL_OPENGL_ES_BIT | EGL_OPENGL_ES2_BIT |
+                          EGL_OPENGL_ES3_BIT_KHR;
+
+   disp->Extensions.KHR_no_config_context = EGL_TRUE;
+   disp->Extensions.KHR_surfaceless_context = EGL_TRUE;
+   disp->Extensions.MESA_query_driver = EGL_TRUE;
+   disp->Extensions.KHR_create_context = EGL_TRUE;
+   disp->Extensions.KHR_reusable_sync = EGL_TRUE;
+   disp->Extensions.EXT_pixel_format_float = EGL_TRUE;
+   if (screen->is_format_supported(screen, PIPE_FORMAT_B8G8R8A8_SRGB,
+                                   PIPE_TEXTURE_2D, 0, 0,
+                                   PIPE_BIND_RENDER_TARGET))
+      disp->Extensions.KHR_gl_colorspace = EGL_TRUE;
+
+   exos_add_config(disp, 1, 24, 8);
+   exos_add_config(disp, 2, 0, 0);
+   if (!_eglGetArraySize(disp->Configs)) {
+      exos_display_destroy(disp);
+      return _eglError(EGL_NOT_INITIALIZED, "EX-OS: no EGL config");
+   }
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+exos_initialize(_EGLDisplay *disp)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+
+   if (edpy) {
+      edpy->ref_count++;
+      return EGL_TRUE;
+   }
+   /* exos: EGL_DEFAULT_DISPLAY (the native platform), ExWin windows and
+    * pbuffers; surfaceless and device (EGL_MESA_platform_surfaceless,
+    * EGL_EXT_device_*): pbuffers and surfaceless contexts only */
+   switch (disp->Platform) {
+   case _EGL_PLATFORM_EXOS:
+   case _EGL_PLATFORM_SURFACELESS:
+   case _EGL_PLATFORM_DEVICE:
+      return exos_initialize_impl(disp);
+   default:
+      return _eglError(EGL_NOT_INITIALIZED,
+                       "EX-OS: only the exos, surfaceless and device platforms");
+   }
+}
+
+static EGLBoolean
+exos_terminate(_EGLDisplay *disp)
+{
+   exos_display_destroy(disp);
+   return EGL_TRUE;
+}
+
+/* --- contexts ------------------------------------------------------------ */
+
+static _EGLContext *
+exos_create_context(_EGLDisplay *disp, _EGLConfig *conf,
+                    _EGLContext *share_list, const EGLint *attrib_list)
+{
+   struct exos_egl_display *edpy = exos_egl_display(disp);
+   struct exos_egl_context *ctx = calloc(1, sizeof(*ctx));
+   struct st_visual visual;
+
+   if (!ctx) {
+      _eglError(EGL_BAD_ALLOC, "eglCreateContext");
+      return NULL;
+   }
+   if (!_eglInitContext(&ctx->base, disp, conf, share_list, attrib_list)) {
+      free(ctx);
+      return NULL;
+   }
+   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_DEPTH | HGL_STENCIL);
+   {
+      /* the API eglBindAPI chose and the version of the attributes */
+      int api;
+      if (ctx->base.ClientAPI == EGL_OPENGL_ES_API)
+         api = ctx->base.ClientMajorVersion <= 1 ? API_OPENGLES : API_OPENGLES2;
+      else if (ctx->base.Profile == EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR &&
+               (ctx->base.ClientMajorVersion > 3 ||
+                (ctx->base.ClientMajorVersion == 3 && ctx->base.ClientMinorVersion >= 2)))
+         api = API_OPENGL_CORE;
+      else
+         api = API_OPENGL_COMPAT;
+      ctx->ctx = hgl_create_context_api(edpy->disp, &visual,
+                                        share_list ? exos_egl_context(share_list)->ctx->st : NULL,
+                                        api, ctx->base.ClientMajorVersion,
+                                        ctx->base.ClientMinorVersion);
+   }
+   if (!ctx->ctx) {
+      free(ctx);
+      _eglError(EGL_BAD_ALLOC, "eglCreateContext");
+      return NULL;
+   }
+   return &ctx->base;
+}
+
+static EGLBoolean
+exos_destroy_context(_EGLDisplay *disp, _EGLContext *c)
+{
+   if (_eglPutContext(c)) {
+      hgl_destroy_context(exos_egl_context(c)->ctx);
+      free(c);
+   }
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+exos_make_current(_EGLDisplay *disp, _EGLSurface *dsurf, _EGLSurface *rsurf,
+                  _EGLContext *c)
+{
+   struct exos_egl_context *ctx = exos_egl_context(c);
+   struct exos_egl_surface *ds = exos_egl_surface(dsurf);
+   struct exos_egl_surface *rs = exos_egl_surface(rsurf);
+   _EGLContext *old_ctx;
+   _EGLSurface *old_dsurf, *old_rsurf;
+
+   if (!_eglBindContext(c, dsurf, rsurf, &old_ctx, &old_dsurf, &old_rsurf))
+      return EGL_FALSE;
+
+   if (old_ctx == c && old_dsurf == dsurf && old_rsurf == rsurf) {
+      _eglPutSurface(old_dsurf);
+      _eglPutSurface(old_rsurf);
+      _eglPutContext(old_ctx);
+      return EGL_TRUE;
+   }
+
+   if (c == NULL)
+      st_api_make_current(NULL, NULL, NULL);
+   else
+      st_api_make_current(ctx->ctx->st, ds ? &ds->fb->base : NULL,
+                          rs ? &rs->fb->base : NULL);
+
+   if (old_dsurf != NULL)
+      exos_destroy_surface(disp, old_dsurf);
+   if (old_rsurf != NULL)
+      exos_destroy_surface(disp, old_rsurf);
+   if (old_ctx != NULL)
+      exos_destroy_context(disp, old_ctx);
+   return EGL_TRUE;
+}
+
+const _EGLDriver _eglDriver = {
+   .Initialize = exos_initialize,
+   .Terminate = exos_terminate,
+   .CreateContext = exos_create_context,
+   .DestroyContext = exos_destroy_context,
+   .MakeCurrent = exos_make_current,
+   .CreateWindowSurface = exos_create_window_surface,
+   .CreatePixmapSurface = exos_create_pixmap_surface,
+   .CreatePbufferSurface = exos_create_pbuffer_surface,
+   .DestroySurface = exos_destroy_surface,
+   .SwapBuffers = exos_swap_buffers,
+};
