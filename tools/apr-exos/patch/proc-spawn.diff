+#ifdef __exos__
+/* EX-OS has no fork(): a process is born with spawn_ex() (lib/include/libc.h
+ * in EX-OS), which takes the program, its arguments, its environment and the
+ * replacements of descriptors 0-2, and nothing else of the parent. So the
+ * child gets only what APR would have left it after the cleanups for exec,
+ * and the work the child did between fork and exec is done here:
+ *   - currdir: the parent changes directory around the spawn (the child is
+ *     born in the parent's one), and goes back;
+ *   - a child_* with filedes -1 (closed in the child): /dev/null instead;
+ *   - APR_SHELLCMD*: SHELL_PATH -c "<the arguments in one string>";
+ *   - APR_PROGRAM_PATH: spawn_ex searches PATH by itself;
+ *   - APR_PROGRAM_ENV / APR_SHELLCMD_ENV: the parent's environ.
+ * Not done: another user or group for the child (refused with APR_ENOTIMPL,
+ * a child must not run as root by mistake), the resource limits of
+ * apr_procattr_limit_set and the perms_set callbacks (ignored), detach (an
+ * EX-OS child is already apart from the parent's console). */
+extern char **environ;
+
+static apr_status_t exos_proc_spawn(apr_proc_t *new, const char *progname,
+                                    const char * const *args,
+                                    const char * const *env,
+                                    apr_procattr_t *attr, apr_pool_t *pool)
+{
+    SpawnRedir   r[3];
+    apr_file_t  *figlio[3];
+    const char  *newargs[4];
+    const char * const *argv = args;
+    const char  *path = progname;
+    char * const *envp = (char * const *)env;
+    char         vecchia[1024];
+    int          n = 0, i, pid, salvato = 0;
+
+    if ((attr->uid != (apr_uid_t)-1 && attr->uid != geteuid()) ||
+        (attr->gid != (apr_gid_t)-1 && attr->gid != getegid())) {
+        return APR_ENOTIMPL;
+    }
+
+    figlio[0] = attr->child_in;
+    figlio[1] = attr->child_out;
+    figlio[2] = attr->child_err;
+    for (i = 0; i < 3; i++) {
+        if (figlio[i] == NULL) {
+            continue;
+        }
+        r[n].fd = i;
+        if (figlio[i]->filedes == -1) {
+            r[n].flags = i == 0 ? O_RDONLY : O_WRONLY;
+            r[n].percorso = "/dev/null";
+            r[n].fd_padre = -1;
+        }
+        else {
+            r[n].flags = 0;
+            r[n].percorso = NULL;
+            r[n].fd_padre = figlio[i]->filedes;
+        }
+        n++;
+    }
+
+    if (attr->cmdtype == APR_PROGRAM_ENV || attr->cmdtype == APR_SHELLCMD_ENV) {
+        envp = environ;
+    }
+
+    if (attr->cmdtype == APR_SHELLCMD || attr->cmdtype == APR_SHELLCMD_ENV) {
+        int onearg_len = 0;
+
+        for (i = 0; args[i]; i++) {
+            onearg_len += strlen(args[i]) + 1;
+        }
+        if (i == 0) {
+            return APR_EINVAL;
+        }
+        newargs[0] = SHELL_PATH;
+        newargs[1] = "-c";
+        if (i == 1) {
+            newargs[2] = args[0];
+        }
+        else {
+            char *ch, *onearg;
+
+            ch = onearg = apr_palloc(pool, onearg_len);
+            for (i = 0; args[i]; i++) {
+                size_t len = strlen(args[i]);
+
+                memcpy(ch, args[i], len);
+                ch += len;
+                *ch++ = ' ';
+            }
+            ch[-1] = '\0';
+            newargs[2] = onearg;
+        }
+        newargs[3] = NULL;
+        path = SHELL_PATH;
+        argv = newargs;
+    }
+    else if (attr->cmdtype != APR_PROGRAM_PATH && strchr(progname, '/') == NULL) {
+        /* the other kinds want a path, not a name to look up */
+        char *rel = apr_pstrcat(pool, "./", progname, NULL);
+
+        path = rel;
+    }
+
+    if (attr->currdir != NULL) {
+        if (getcwd(vecchia, sizeof(vecchia)) == NULL) {
+            return errno;
+        }
+        if (chdir(attr->currdir) == -1) {
+            return errno;
+        }
+        salvato = 1;
+    }
+    pid = spawn_ex(path, (char * const *)argv, envp, r, n);
+    i = errno;
+    if (salvato) {
+        (void)chdir(vecchia);
+    }
+    if (pid < 0) {
+        if (attr->errfn) {
+            attr->errfn(pool, i, apr_psprintf(pool, "spawn of '%s' failed", progname));
+        }
+        return i;
+    }
+    new->pid = pid;
+    return APR_SUCCESS;
+}
+#endif /* __exos__ */
