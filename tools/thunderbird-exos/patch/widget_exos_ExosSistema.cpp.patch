+};
+
+const char* ExtDelTipo(const nsACString& aMime) {
+  for (const auto& t : kTipi) {
+    if (aMime.EqualsIgnoreCase(t.mime)) return t.ext;
+  }
+  return nullptr;
+}
+
+const char* TipoDellExt(const nsACString& aExt) {
+  for (const auto& t : kTipi) {
+    if (aExt.EqualsIgnoreCase(t.ext)) return t.mime;
+  }
+  return nullptr;
+}
