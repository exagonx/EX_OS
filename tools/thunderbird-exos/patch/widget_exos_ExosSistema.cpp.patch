+// The layout of ExTipo in lib/exwin/exwin.h.
+struct ExTipo {
+  char gruppo[32];
+  char tipo[16];
+  char predefinito[200];
+  char scelto[200];
+};
+
+struct Exwin {
+  int (*type_program)(const char*, char*, unsigned int);
+  int (*types)(ExTipo*, int);
+  int (*type_set)(const char*, const char*);
+  int (*open_file)(const char*, char*, unsigned int);
+  int (*spawn_program)(const char*, char* const[], const char*);
+};
+
+// exwin.so, opened once; nullptr when it is not there (no ExWin installed).
+const Exwin* exwin() {
+  static Exwin e;
+  static int stato = 0;  // 0 not tried, 1 good, -1 missing
+  if (stato == 0) {
+    void* h = dlopen("/exwin/lib/exwin.so", RTLD_NOW);
+    if (!h) h = dlopen("/cdrom/exwin/lib/exwin.so", RTLD_NOW);
+    if (h) {
+      e.type_program = (int (*)(const char*, char*, unsigned int))dlsym(
+          h, "ex_type_program");
+      e.types = (int (*)(ExTipo*, int))dlsym(h, "ex_types");
+      e.type_set = (int (*)(const char*, const char*))dlsym(h, "ex_type_set");
+      e.open_file =
+          (int (*)(const char*, char*, unsigned int))dlsym(h, "ex_open_file");
+      e.spawn_program = (int (*)(const char*, char* const[], const char*))dlsym(
+          h, "ex_spawn_program");
+    }
+    stato = (h && e.type_program && e.open_file && e.spawn_program) ? 1 : -1;
+    if (stato < 0) fprintf(stderr, "exilla: exwin.so non c'e', niente programmi di sistema\n");
+  }
+  return stato > 0 ? &e : nullptr;
+}
+
