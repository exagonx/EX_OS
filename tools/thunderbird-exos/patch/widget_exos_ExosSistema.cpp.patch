+// One program of EX-OS, as Firefox sees a handler application.
+class nsExosProgramma final : public nsIGIOMimeApp {
+  ~nsExosProgramma() = default;
+
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIHANDLERAPP
+  NS_DECL_NSIGIOMIMEAPP
+
+  explicit nsExosProgramma(const nsACString& aProg) : mProg(aProg) {
+    NomeDelProgramma(mProg, mNome);
+  }
+
+ private:
+  nsCString mProg;
+  nsString mNome;
+};
+
+NS_IMPL_ISUPPORTS(nsExosProgramma, nsIGIOMimeApp, nsIHandlerApp)
+
+NS_IMETHODIMP nsExosProgramma::GetId(nsACString& aId) {
+  aId = mProg;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::GetName(nsAString& aName) {
+  aName = mNome;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::SetName(const nsAString& aName) {
+  mNome = aName;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::GetDetailedDescription(nsAString& aDesc) {
+  CopyUTF8toUTF16(mProg, aDesc);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::SetDetailedDescription(const nsAString&) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP nsExosProgramma::Equals(nsIHandlerApp* aOther, bool* _retval) {
+  *_retval = false;
+  nsCOMPtr<nsIGIOMimeApp> altro = do_QueryInterface(aOther);
+  if (altro) {
+    nsAutoCString id;
+    altro->GetId(id);
+    *_retval = id.Equals(mProg);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::LaunchWithURI(
+    nsIURI* aUri, mozilla::dom::BrowsingContext* aBrowsingContext) {
+  nsAutoCString arg;
+  nsCOMPtr<nsIFileURL> fileUrl = do_QueryInterface(aUri);
+  if (fileUrl) {
+    nsCOMPtr<nsIFile> file;
+    nsresult rv = fileUrl->GetFile(getter_AddRefs(file));
+    NS_ENSURE_SUCCESS(rv, rv);
+    file->GetNativePath(arg);
+  } else {
+    aUri->GetSpec(arg);
+  }
+  return Lancia(mProg, arg);
+}
+
+NS_IMETHODIMP nsExosProgramma::GetCommand(nsACString& aCommand) {
+  aCommand = mProg;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::GetExpectsURIs(int32_t* aExpects) {
+  *aExpects = nsIGIOMimeApp::EXPECTS_URIS_FOR_NON_FILES;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosProgramma::GetSupportedURISchemes(
+    nsIUTF8StringEnumerator** aSchemes) {
+  auto* schemi = new nsTArray<nsCString>();
+  schemi->AppendElement("file"_ns);
+  return NS_NewAdoptingUTF8StringEnumerator(aSchemes, schemi);
+}
+
+static nsresult Scegli(const char* aTipo, const nsACString& aProg) {
+  const Exwin* e = exwin();
+  if (!e || !e->type_set || !aTipo) return NS_ERROR_NOT_AVAILABLE;
+  return e->type_set(aTipo, PromiseFlatCString(aProg).get()) ? NS_OK
+                                                             : NS_ERROR_FAILURE;
+}
+
+NS_IMETHODIMP nsExosProgramma::SetAsDefaultForMimeType(
+    const nsACString& aMimeType) {
+  return Scegli(ExtDelTipo(aMimeType), mProg);
+}
+
+NS_IMETHODIMP nsExosProgramma::SetAsDefaultForFileExtensions(
+    const nsACString& aExts) {
+  nsresult rv = NS_ERROR_INVALID_ARG;
+  for (const nsACString& ext : aExts.Split(' ')) {
+    if (ext.IsEmpty()) continue;
+    nsAutoCString e(ext);
+    if (e.First() == '.') e.Cut(0, 1);
+    rv = Scegli(e.get(), mProg);
+    if (NS_FAILED(rv)) return rv;
+  }
+  return rv;
+}
+
+NS_IMETHODIMP nsExosProgramma::SetAsDefaultForURIScheme(
+    const nsACString& aScheme) {
+  nsAutoCString t(aScheme);
+  t.Append(':');
+  return Scegli(t.get(), mProg);
+}
+
+NS_IMPL_ISUPPORTS(nsExosSistema, nsIGIOService)
+
+NS_IMETHODIMP nsExosSistema::GetMimeTypeFromExtension(const nsACString& aExt,
+                                                      nsACString& aMime) {
+  const char* m = TipoDellExt(aExt);
+  if (!m) return NS_ERROR_FAILURE;
+  aMime.Assign(m);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::GetAppForURIScheme(const nsACString& aScheme,
+                                                nsIHandlerApp** aApp) {
+  *aApp = nullptr;
+  nsAutoCString t(aScheme), prog;
+  t.Append(':');
+  if (!ProgrammaDelTipo(t.get(), prog)) return NS_ERROR_FAILURE;
+  NS_ADDREF(*aApp = new nsExosProgramma(prog));
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::GetAppsForURIScheme(const nsACString& aScheme,
+                                                 nsIMutableArray** aResult) {
+  nsCOMPtr<nsIMutableArray> tutti = do_CreateInstance(NS_ARRAY_CONTRACTID);
+  nsCOMPtr<nsIHandlerApp> app;
+  if (NS_SUCCEEDED(GetAppForURIScheme(aScheme, getter_AddRefs(app))) && app) {
+    tutti->AppendElement(app);
+  }
+  tutti.forget(aResult);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::GetAppForMimeType(const nsACString& aMimeType,
+                                               nsIHandlerApp** aApp) {
+  *aApp = nullptr;
+  nsAutoCString prog;
+  if (!ProgrammaDelTipo(ExtDelTipo(aMimeType), prog)) return NS_ERROR_FAILURE;
+  NS_ADDREF(*aApp = new nsExosProgramma(prog));
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::CreateHandlerAppFromAppId(
+    const char*, nsIGIOHandlerApp** aResult) {
+  *aResult = nullptr;
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP nsExosSistema::CreateAppFromCommand(const nsACString& aCmd,
+                                                  const nsACString& aName,
+                                                  nsIGIOMimeApp** aApp) {
+  *aApp = nullptr;
+  RefPtr<nsExosProgramma> p = new nsExosProgramma(aCmd);
+  if (!aName.IsEmpty()) p->SetName(NS_ConvertUTF8toUTF16(aName));
+  p.forget(aApp);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::FindAppFromCommand(const nsACString& aCmd,
+                                                nsIGIOMimeApp** aApp) {
+  *aApp = nullptr;
+  struct stat st;
+  if (stat(PromiseFlatCString(aCmd).get(), &st) != 0 || !S_ISREG(st.st_mode)) {
+    return NS_ERROR_FAILURE;
+  }
+  NS_ADDREF(*aApp = new nsExosProgramma(aCmd));
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::GetDescriptionForMimeType(
+    const nsACString& aMimeType, nsACString& aDesc) {
+  const char* ext = ExtDelTipo(aMimeType);
+  const Exwin* e = exwin();
+  aDesc.Truncate();
+  if (!ext || !e || !e->types) return NS_ERROR_FAILURE;
+  int n = e->types(nullptr, 0);
+  if (n <= 0) return NS_ERROR_FAILURE;
+  nsTArray<ExTipo> v;
+  v.SetLength(n);
+  n = e->types(v.Elements(), n);
+  for (int i = 0; i < n && i < (int)v.Length(); i++) {
+    if (!strcmp(v[i].tipo, ext)) {
+      aDesc.Assign(v[i].gruppo);
+      return NS_OK;
+    }
+  }
+  return NS_ERROR_FAILURE;
+}
+
+NS_IMETHODIMP nsExosSistema::GetIsRunningUnderFlatpak(bool* aResult) {
+  *aResult = false;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::GetIsRunningUnderSnap(bool* aResult) {
+  *aResult = false;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsExosSistema::ShowURI(nsIURI* aURI) {
+  nsCOMPtr<nsIFileURL> fileUrl = do_QueryInterface(aURI);
+  if (fileUrl) {
+    nsCOMPtr<nsIFile> file;
+    nsresult rv = fileUrl->GetFile(getter_AddRefs(file));
+    NS_ENSURE_SUCCESS(rv, rv);
+    nsAutoCString path;
+    file->GetNativePath(path);
+    return Apri(path);
+  }
+  nsAutoCString scheme, spec, prog;
+  aURI->GetScheme(scheme);
+  aURI->GetSpec(spec);
+  scheme.Append(':');
+  if (!ProgrammaDelTipo(scheme.get(), prog)) return NS_ERROR_FAILURE;
+  return Lancia(prog, spec);
+}
+
+NS_IMETHODIMP nsExosSistema::RevealFile(nsIFile* aFile) {
+  nsCOMPtr<nsIFile> cartella;
+  bool dir = false;
+  if (NS_SUCCEEDED(aFile->IsDirectory(&dir)) && dir) {
+    cartella = aFile;
+  } else {
+    nsresult rv = aFile->GetParent(getter_AddRefs(cartella));
+    if (NS_FAILED(rv) || !cartella) return NS_ERROR_FAILURE;
+  }
+  nsAutoCString path;
+  cartella->GetNativePath(path);
+  return Apri(path);
+}
+
+NS_IMETHODIMP nsExosSistema::LaunchFile(const nsACString& aPath) {
+  return Apri(aPath);
+}
