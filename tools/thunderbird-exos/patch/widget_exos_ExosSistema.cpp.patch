+// The name the menu gives a program (/exwin/lib/applicazioni.txt:
+// "Group/Name | /path | icon"), or its file name.
+void NomeDelProgramma(const nsACString& aProg, nsAString& aNome) {
+  nsAutoCString nome;
+  FILE* f = fopen("/exwin/lib/applicazioni.txt", "r");
+  if (!f) f = fopen("/cdrom/exwin/lib/applicazioni.txt", "r");
+  if (f) {
+    char riga[512];
+    while (fgets(riga, sizeof(riga), f)) {
+      char* b1 = strchr(riga, '|');
+      if (riga[0] == '#' || !b1) continue;
+      char* p = b1 + 1;
+      while (*p == ' ' || *p == '\t') p++;
+      char* fine = p;
+      while (*fine && *fine != ' ' && *fine != '\t' && *fine != '|' &&
+             *fine != '\n' && *fine != '\r')
+        fine++;
+      if (!aProg.Equals(nsDependentCSubstring(p, fine - p))) continue;
+      char* n = riga;
+      for (char* s = riga; s < b1; s++) {
+        if (*s == '/') n = s + 1;
+      }
+      char* nf = b1;
+      while (nf > n && (nf[-1] == ' ' || nf[-1] == '\t')) nf--;
+      nome.Assign(n, nf - n);
+      break;
+    }
+    fclose(f);
+  }
+  if (nome.IsEmpty()) {
+    int32_t barra = aProg.RFindChar('/');
+    nome = Substring(aProg, barra + 1);
+  }
+  CopyUTF8toUTF16(nome, aNome);
+}
+
+nsresult Lancia(const nsACString& aProg, const nsACString& aArg) {
+  const Exwin* e = exwin();
+  if (!e) return NS_ERROR_NOT_AVAILABLE;
+  nsAutoCString prog(aProg), arg(aArg);
+  char* argv[3] = {prog.BeginWriting(), arg.BeginWriting(), nullptr};
+  return e->spawn_program(prog.get(), argv, nullptr) >= 0 ? NS_OK
+                                                          : NS_ERROR_FAILURE;
+}
+
+nsresult Apri(const nsACString& aPercorso) {
+  const Exwin* e = exwin();
+  if (!e) return NS_ERROR_NOT_AVAILABLE;
+  return e->open_file(PromiseFlatCString(aPercorso).get(), nullptr, 0) >= 0
+             ? NS_OK
+             : NS_ERROR_FAILURE;
+}
+
+bool ProgrammaDelTipo(const char* aTipo, nsACString& aProg) {
+  const Exwin* e = exwin();
+  char p[200];
+  if (!e || !aTipo || !e->type_program(aTipo, p, sizeof(p))) return false;
+  aProg.Assign(p);
+  return true;
+}
