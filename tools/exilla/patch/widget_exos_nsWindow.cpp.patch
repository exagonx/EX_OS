+
+bool nsWindow::GetEditCommands(NativeKeyBindingsType aType,
+                               const WidgetKeyboardEvent& aEvent,
+                               nsTArray<CommandInt>& aCommands) {
+  if (NS_WARN_IF(!nsIWidget::GetEditCommands(aType, aEvent, aCommands))) {
+    return false;
+  }
+  Maybe<WritingMode> writingMode;
+  if (aEvent.NeedsToRemapNavigationKey()) {
+    if (RefPtr<TextEventDispatcher> dispatcher = GetTextEventDispatcher()) {
+      writingMode = dispatcher->MaybeQueryWritingModeAtSelection();
+    }
+  }
+  HeadlessKeyBindings::GetInstance().GetEditCommands(aType, aEvent, writingMode,
+                                                     aCommands);
+  return true;
+}
+
+already_AddRefed<gfx::DrawTarget> nsWindow::StartRemoteDrawingInRegion(
+    const LayoutDeviceIntRegion& aInvalidRegion) {
+  static int sPrime = 0;
+  if (sPrime < 5) {
+    sPrime++;
+    DIARIO("StartRemoteDrawing %p zona %p", this, (void*)mZona);
+  }
+  mZonaLock.Lock();
+  if (!mZona || mZonaW <= 0 || mZonaH <= 0) {
+    mZonaLock.Unlock();
+    return nullptr;
+  }
+  RefPtr<gfx::DrawTarget> dt = gfx::Factory::CreateDrawTargetForData(
+      gfx::BackendType::SKIA, (uint8_t*)mZona, gfx::IntSize(mZonaW, mZonaH),
+      mZonaW * 4, gfx::SurfaceFormat::B8G8R8A8);
+  if (!dt) {
+    mZonaLock.Unlock();
+    return nullptr;
+  }
+  return dt.forget();
+}
+
+void nsWindow::EndRemoteDrawingInRegion(
+    gfx::DrawTarget* aDrawTarget, const LayoutDeviceIntRegion& aInvalidRegion) {
+  uint32_t id = mZonaId;
+  LayoutDeviceIntRect r = aInvalidRegion.GetBounds().Intersect(
+      LayoutDeviceIntRect(0, 0, mZonaW, mZonaH));
+  mZonaLock.Unlock();
+
+  if (id && !r.IsEmpty()) {
+    WinRegione u = {id, (unsigned int)r.X(), (unsigned int)r.Y(),
+                    (unsigned int)r.Width(), (unsigned int)r.Height()};
+    exos::Manda(WIN_MSG_AGGIORNA, &u, sizeof(u));
+  }
+}
+
+void nsWindow::OnServerResized(const void* aCreata) {
+  const WinCreata* r = static_cast<const WinCreata*>(aCreata);
+  if (!mId || r->giro == mGiro) {
+    return;
+  }
+  if (!AttaccaZona(r->id, r->giro, r->byte, (int32_t)r->larghezza,
+                   (int32_t)r->altezza)) {
+    return;
+  }
+  // The receipt: an update as large as the new zone (wserver.c).
+  WinRegione u = {mId, 0, 0, r->larghezza, r->altezza};
+  exos::Manda(WIN_MSG_AGGIORNA, &u, sizeof(u));
+  ResizeInternal((int32_t)r->larghezza, (int32_t)r->altezza);
+}
+
+void nsWindow::OnServerMoved(int32_t aX, int32_t aY) { MoveInternal(aX, aY); }
+
+void nsWindow::CreateCompositor(int aWidth, int aHeight) {
+  DIARIO("CreateCompositor %p %dx%d: start", this, aWidth, aHeight);
+  nsIWidget::CreateCompositor(aWidth, aHeight);
+  DIARIO("CreateCompositor %p: done", this);
+}
+
+static Modifiers Modificatori(uint32_t aKbd) {
+  Modifiers m = 0;
+  if (aKbd & KBD_MOD_SHIFT) m |= MODIFIER_SHIFT;
+  if (aKbd & KBD_MOD_CTRL) m |= MODIFIER_CONTROL;
+  if (aKbd & KBD_MOD_ALT) m |= MODIFIER_ALT;
+  return m;
+}
+
+int32_t nsWindow::ContaClic(int32_t aX, int32_t aY, uint32_t aTempo) {
+  if (mClic > 0 && aTempo - mUltimoGiuTempo < 500 &&
+      std::abs(aX - mUltimoGiuX) <= 4 && std::abs(aY - mUltimoGiuY) <= 4) {
+    mClic++;
+  } else {
+    mClic = 1;
+  }
+  mUltimoGiuTempo = aTempo;
+  mUltimoGiuX = aX;
+  mUltimoGiuY = aY;
+  return mClic;
+}
+
+void nsWindow::Mouse(EventMessage aMessaggio, int32_t aX, int32_t aY,
+                     int16_t aBottone, uint32_t aBottoni,
+                     uint32_t aModificatori) {
+  WidgetMouseEvent ev(true, aMessaggio, this, WidgetMouseEvent::eReal);
+  ev.mRefPoint = LayoutDeviceIntPoint(aX, aY);
+  ev.mButton = aBottone;
+  ev.mButtons = (int16_t)(aBottoni & 7);
+  ev.mModifiers = Modificatori(aModificatori);
+  if (aMessaggio == eMouseDown || aMessaggio == eMouseUp) {
+    ev.mClickCount = mClic;
+  }
+  if (aMessaggio == eMouseExitFromWidget) {
+    ev.mExitFrom = Some(WidgetMouseEvent::ePlatformTopLevel);
+  }
+  ev.AssignEventTime(WidgetEventTime());
+  DispatchInputEvent(&ev);
+}
+
+void nsWindow::MenuContestuale(int32_t aX, int32_t aY,
+                               uint32_t aModificatori) {
+  WidgetPointerEvent ev(true, eContextMenu, this);
+  ev.mRefPoint = LayoutDeviceIntPoint(aX, aY);
+  ev.mButton = MouseButton::eSecondary;
+  ev.mModifiers = Modificatori(aModificatori);
+  ev.AssignEventTime(WidgetEventTime());
+  DispatchInputEvent(&ev);
+}
+
+void nsWindow::Rotella(int32_t aX, int32_t aY, int32_t aScatti) {
+  WidgetWheelEvent ev(true, eWheel, this);
+  ev.mRefPoint = LayoutDeviceIntPoint(aX, aY);
+  ev.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_LINE;
+  ev.mDeltaY = 3.0 * aScatti;
+  ev.mLineOrPageDeltaY = 3 * aScatti;
+  ev.mWheelTicksY = aScatti;
+  ev.AssignEventTime(WidgetEventTime());
+  DispatchInputEvent(&ev);
+}
+
+// The console of EX-OS speaks code page 437: the keyboard maps give the
+// accented letters as their CP437 byte.
+static const char16_t kCp437[128] = {
+    0x00C7, 0x00FC, 0x00E9, 0x00E2, 0x00E4, 0x00E0, 0x00E5, 0x00E7, 0x00EA,
+    0x00EB, 0x00E8, 0x00EF, 0x00EE, 0x00EC, 0x00C4, 0x00C5, 0x00C9, 0x00E6,
