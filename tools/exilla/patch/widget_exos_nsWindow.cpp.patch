+static void PreparaTasto(WidgetKeyboardEvent& aEv, uint32_t aKeyCode,
+                         KeyNameIndex aNome, char16_t aCarattere,
+                         Modifiers aMod) {
+  aEv.mKeyCode = aKeyCode;
+  aEv.mKeyNameIndex = aNome;
+  aEv.mCodeNameIndex = CODE_NAME_INDEX_UNKNOWN;
+  if (aNome == KEY_NAME_INDEX_USE_STRING) {
+    aEv.mKeyValue.Assign(aCarattere);
+  }
+  aEv.mModifiers = aMod;
+  aEv.mLocation = eKeyLocationStandard;
+  aEv.mIsRepeat = false;
+  aEv.mTimeStamp = TimeStamp::Now();
+}
+
+void nsWindow::Tasto(uint32_t aCodice) {
+  uint32_t base = aCodice & KBD_KEY_MASK;
+  uint32_t keyCode = 0;
+  KeyNameIndex nome = KEY_NAME_INDEX_USE_STRING;
+  char16_t carattere = 0;
+  Modifiers mod = Modificatori(aCodice);
+
+  for (const TastoSpeciale& s : kSpeciali) {
+    if (s.mKbd == base) {
+      keyCode = s.mKeyCode;
+      nome = s.mNome;
+      break;
+    }
+  }
+  if (nome == KEY_NAME_INDEX_USE_STRING) {
+    if (base >= 0x80 && base < 0x100) {
+      carattere = kCp437[base - 0x80];
+    } else if (base >= 32 && base < 0x100) {
+      carattere = (char16_t)base;
+    } else {
+      return;
+    }
+    keyCode = WidgetUtils::ComputeKeyCodeFromChar(carattere);
+  }
+
+  RefPtr<TextEventDispatcher> d = GetTextEventDispatcher();
+  if (!d || NS_FAILED(d->BeginNativeInputTransaction())) {
+    return;
+  }
+
+  RefPtr<nsWindow> kungFuDeathGrip(this);
+  nsEventStatus stato = nsEventStatus_eIgnore;
+  WidgetKeyboardEvent giu(true, eKeyDown, this);
+  PreparaTasto(giu, keyCode, nome, carattere, mod);
+  d->DispatchKeyboardEvent(eKeyDown, giu, stato);
+  if (mDestroyed) {
+    return;
+  }
+  if (stato != nsEventStatus_eConsumeNoDefault) {
+    WidgetKeyboardEvent premi(true, eKeyPress, this);
+    PreparaTasto(premi, keyCode, nome, carattere, mod);
+    if (NS_FAILED(d->BeginNativeInputTransaction())) {
+      return;
+    }
+    d->MaybeDispatchKeypressEvents(premi, stato);
+    if (mDestroyed) {
+      return;
+    }
+  }
+  WidgetKeyboardEvent su(true, eKeyUp, this);
+  PreparaTasto(su, keyCode, nome, carattere, mod);
+  stato = nsEventStatus_eIgnore;
+  if (NS_FAILED(d->BeginNativeInputTransaction())) {
+    return;
+  }
+  d->DispatchKeyboardEvent(eKeyUp, su, stato);
+}
+
+void nsWindow::OnServerEvent(const void* aEvento) {
+  const WinEvento* e = static_cast<const WinEvento*>(aEvento);
+  int32_t x = (int32_t)e->x;
+  int32_t y = (int32_t)e->y;
+  RefPtr<nsWindow> kungFuDeathGrip(this);
+
+  if (e->tipo != WIN_EV_MOUSE_MOSSO) {
+    static int sDetti = 0;
+    if (sDetti < 60) {
+      sDetti++;
+      DIARIO("evento %u su %p a %d,%d tasto 0x%x (server %u ms)", e->tipo,
+             this, x, y, e->tasto, e->tempo);
+    }
+  }
+
+  switch (e->tipo) {
+    case WIN_EV_MOUSE_MOSSO:
+      if (!mDentro) {
+        mDentro = true;
+        Mouse(eMouseEnterIntoWidget, x, y, MouseButton::ePrimary, e->bottoni,
+              0);
+      }
+      Mouse(eMouseMove, x, y, MouseButton::ePrimary, e->bottoni, 0);
+      break;
+    case WIN_EV_MOUSE_GIU:
+      ContaClic(x, y, e->tempo);
+      Mouse(eMouseDown, x, y, MouseButton::ePrimary, MOUSE_BTN_SIN, e->tasto);
+      break;
+    case WIN_EV_MOUSE_SU:
+      Mouse(eMouseUp, x, y, MouseButton::ePrimary, e->bottoni, 0);
+      break;
+    case WIN_EV_DESTRO:
+      mClic = 1;
+      Mouse(eMouseDown, x, y, MouseButton::eSecondary, MOUSE_BTN_DES,
+            e->tasto);
+      if (!mDestroyed) {
+        MenuContestuale(x, y, e->tasto);
+      }
+      if (!mDestroyed) {
+        Mouse(eMouseUp, x, y, MouseButton::eSecondary, 0, e->tasto);
+      }
+      break;
+    case WIN_EV_ROTELLA:
+      Rotella(x, y, (int32_t)e->tasto);
+      break;
+    case WIN_EV_USCITO:
+      if (mDentro) {
+        mDentro = false;
+        Mouse(eMouseExitFromWidget, x, y, MouseButton::ePrimary, 0, 0);
+      }
+      break;
+    case WIN_EV_TASTO: {
+      // Keys go to the top-level window: a popup (a menu) is driven by the
+      // document of the window that opened it, as on the other platforms.
+      RefPtr<nsWindow> bersaglio = this;
+      if (mWindowType == WindowType::Popup) {
+        if (RefPtr<nsWindow> attiva = FinestraAttiva()) {
+          bersaglio = attiva;
+        }
+      }
+      bersaglio->Tasto(e->tasto);
+      break;
+    }
+    case WIN_EV_CHIUDI:
+      if (mWindowType == WindowType::Popup) {
+        if (nsIRollupListener* rl = nsIWidget::GetActiveRollupListener()) {
+          nsIRollupListener::RollupOptions opzioni;
+          rl->Rollup(opzioni);
+        }
+      } else if (mWidgetListener) {
+        mWidgetListener->RequestWindowClose(this);
+      }
+      break;
+    default:
+      break;
+  }
+}
