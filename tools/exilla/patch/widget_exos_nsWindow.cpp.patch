+/* EX-OS (Exilla), first stage: every window is a HeadlessWidget. It lays out
+ * and paints in memory; --screenshot saves the result. The windows of ExWin
+ * come with the next stage (a real nsWindow here). */
+
+#include "nsIWidget.h"
+
+already_AddRefed<nsIWidget> nsIWidget::CreateTopLevelWindow() {
+  return nsIWidget::CreateHeadlessWidget();
+}
+
+already_AddRefed<nsIWidget> nsIWidget::CreateChildWindow() {
+  return nsIWidget::CreateHeadlessWidget();
+}
