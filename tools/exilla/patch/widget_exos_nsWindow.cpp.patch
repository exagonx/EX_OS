+// The windows in order of activation; the last one is the active one.
+static StaticAutoPtr<nsTArray<nsWindow*>> sAttive;
+
+static already_AddRefed<nsWindow> FinestraAttiva() {
+  if (!sAttive || sAttive->IsEmpty()) {
+    return nullptr;
+  }
+  RefPtr<nsWindow> w = sAttive->LastElement();
+  return w.forget();
+}
+
+static bool Diario() {
+  static int sAcceso = -1;
+  if (sAcceso < 0) {
+    const char* v = getenv("EXILLA_DIAG");
+    sAcceso = (v && v[0] == '1') ? 1 : 0;
+  }
+  return sAcceso == 1;
+}
+
+#define DIARIO(...)                           \
+  do {                                        \
+    if (Diario()) {                           \
+      fprintf(stderr, "exilla: " __VA_ARGS__); \
+      fputc('\n', stderr);                    \
+    }                                         \
+  } while (0)
+
+static void Schermo(int32_t* aW, int32_t* aH) {
+  VideoInfo v;
+  if (video_info(&v) != 0 || !v.larghezza || !v.altezza) {
+    v.larghezza = 1024;
+    v.altezza = 768;
+  }
+  *aW = (int32_t)v.larghezza;
+  *aH = (int32_t)v.altezza;
+}
+
+nsWindow::nsWindow() : mZonaLock("nsWindow::mZonaLock") {
+  mWidgetType = WidgetType::Native;
+  if (!sAttive) {
+    sAttive = new nsTArray<nsWindow*>();
+    ClearOnShutdown(&sAttive);
+  }
+}
+
+nsWindow::~nsWindow() { Destroy(); }
+
+nsresult nsWindow::Create(nsIWidget* aParent, const LayoutDeviceIntRect& aRect,
+                          const InitData& aInitData) {
+  BaseCreate(aParent, aInitData);
+  DIARIO("Create %p tipo %d %dx%d a %d,%d", this, (int)aInitData.mWindowType,
+         aRect.Width(), aRect.Height(), aRect.X(), aRect.Y());
+  mBounds = aRect;
+  mRestoreBounds = aRect;
+  mTastiera = new ExosTastiera(this);
+  return NS_OK;
+}
+
+void nsWindow::Destroy() {
+  if (mDestroyed) {
+    return;
+  }
+  mDestroyed = true;
+
+  if (sAttive) {
+    RefPtr<nsWindow> attiva = FinestraAttiva();
+    sAttive->RemoveElement(this);
+    RefPtr<nsWindow> prima = FinestraAttiva();
+    if (this == attiva && prima && prima->mWidgetListener) {
+      prima->mWidgetListener->WindowActivated();
+    }
+  }
+
+  ChiudiFinestra();
+  if (mTastiera) {
+    mTastiera->Spegni();
+    mTastiera = nullptr;
+  }
+
+  nsIWidget::OnDestroy();
+  nsIWidget::Destroy();
+}
+
+bool nsWindow::AttaccaZona(uint32_t aId, uint32_t aGiro, uint32_t aByte,
+                           int32_t aLarghezza, int32_t aAltezza) {
+  ShmZona z;
+  memset(&z, 0, sizeof(z));
+  win_nome_zona(z.nome, aId, aGiro);
+  z.byte = aByte;
+  z.flag = 0;
+  if (shm_apri(&z) != 0 || !z.virt) {
+    return false;
+  }
+
+  uint32_t* vecchia;
+  {
+    MutexAutoLock lock(mZonaLock);
+    vecchia = mZona;
+    mZona = (uint32_t*)(uintptr_t)z.virt;
+    mZonaW = aLarghezza;
+    mZonaH = aAltezza;
+    mZonaId = aId;
+  }
+  if (vecchia) {
+    shm_chiudi(vecchia);
+  }
+  mGiro = aGiro;
+  return true;
+}
+
+void nsWindow::StaccaZona() {
+  uint32_t* vecchia;
+  {
+    MutexAutoLock lock(mZonaLock);
+    vecchia = mZona;
+    mZona = nullptr;
+    mZonaW = mZonaH = 0;
+    mZonaId = 0;
+  }
+  if (vecchia) {
+    shm_chiudi(vecchia);
+  }
+}
+
+bool nsWindow::ApriFinestra() {
+  if (mId || !HaFinestraServer() || !exos::Server()) {
+    return false;
+  }
+
+  int32_t sw, sh;
+  Schermo(&sw, &sh);
+
+  bool popup = mWindowType == WindowType::Popup;
+  int32_t w = std::max(mBounds.Width(), 1);
+  int32_t h = std::max(mBounds.Height(), 1);
+  int32_t x = mBounds.X();
+  int32_t y = mBounds.Y();
+
+  if (!popup) {
+    w = std::min(w, sw - 2 * kBordo);
+    h = std::min(h, sh - kBarra - 2 * kBordo);
+    x = std::clamp(x, kBordo, std::max(kBordo, sw - w - kBordo));
+    y = std::clamp(y, kBarra + kBordo, std::max(kBarra + kBordo, sh - h - kBordo));
+  }
+
+  WinCrea c;
+  memset(&c, 0, sizeof(c));
+  c.x = (unsigned int)std::max(x, 0);
+  c.y = (unsigned int)std::max(y, 0);
+  c.larghezza = (unsigned int)w;
+  c.altezza = (unsigned int)h;
+  c.stile = WIN_ST_VISIBILE |
+            (popup ? WIN_ST_COMPARSA
+                   : WIN_ST_TITOLO | WIN_ST_BORDO | WIN_ST_CHIUDI | WIN_ST_RIDIM);
+  memcpy(c.titolo, mTitolo, WIN_TITOLO_LEN - 1);
+
+  DIARIO("CREA %ux%u a %u,%u stile 0x%x", c.larghezza, c.altezza, c.x, c.y,
+         c.stile);
+  if (exos::Manda(WIN_MSG_CREA, &c, sizeof(c)) < 0) {
+    DIARIO("CREA non spedita");
+    return false;
+  }
+
+  WinCreata r;
+  memset(&r, 0, sizeof(r));
+  if (!exos::AspettaCreata(&r, sizeof(r), 15000) || !r.id) {
+    DIARIO("CREATA non arrivata o rifiutata (id %u)", r.id);
+    return false;
+  }
+  DIARIO("CREATA id %u %ux%u a %u,%u zona %u byte", r.id, r.larghezza,
+         r.altezza, r.x, r.y, r.byte);
+  if (!AttaccaZona(r.id, r.giro, r.byte, (int32_t)r.larghezza,
+                   (int32_t)r.altezza)) {
+    WinRegione d = {r.id, 0, 0, 0, 0};
+    exos::Manda(WIN_MSG_DISTRUGGI, &d, sizeof(d));
+    return false;
+  }
+
+  mId = r.id;
+  exos::Registra(mId, this);
+
+  WinRegione p = {mId, 1, 0, 0, 0};
+  exos::Manda(WIN_MSG_PASSAGGIO, &p, sizeof(p));
+
+  MoveInternal((int32_t)r.x, (int32_t)r.y);
+  ResizeInternal((int32_t)r.larghezza, (int32_t)r.altezza);
+  return true;
+}
+
+void nsWindow::ChiudiFinestra() {
+  if (!mId) {
+    return;
+  }
+  WinRegione d = {mId, 0, 0, 0, 0};
+  exos::Manda(WIN_MSG_DISTRUGGI, &d, sizeof(d));
+  exos::Togli(mId);
+  mId = 0;
+  StaccaZona();
+}
+
+void nsWindow::RaiseWindow() {
+  RefPtr<nsWindow> attiva = FinestraAttiva();
+  if (attiva == this) {
+    return;
+  }
+  if (attiva && attiva->mWidgetListener) {
+    attiva->mWidgetListener->WindowDeactivated();
+  }
+  sAttive->RemoveElement(this);
+  sAttive->AppendElement(this);
+  if (mWidgetListener) {
+    mWidgetListener->WindowActivated();
+  }
+}
+
+void nsWindow::Show(bool aState) {
+  DIARIO("Show %p %d tipo %d", this, aState, (int)mWindowType);
+  mVisible = aState;
+
+  if (HaFinestraServer()) {
+    if (aState) {
+      ApriFinestra();
+    } else {
+      ChiudiFinestra();
+    }
+  }
+
+  if (aState && (mWindowType == WindowType::TopLevel ||
+                 mWindowType == WindowType::Dialog)) {
+    RaiseWindow();
+  }
+  ApplySizeModeSideEffects();
+}
+
+void nsWindow::SetFocus(Raise aRaise, dom::CallerType aCallerType) {
+  if (aRaise != Raise::Yes) {
+    return;
+  }
+  nsWindow* top = static_cast<nsWindow*>(GetTopLevelWidget());
+  if (top && top->IsVisible()) {
+    top->RaiseWindow();
+    if (top->mId) {
+      WinRegione p = {top->mId, 0, 0, 0, 0};
+      exos::Manda(WIN_MSG_PRIMO, &p, sizeof(p));
+    }
+  }
+}
+
+void nsWindow::Move(const DesktopPoint& aPoint) {
+  auto tl = LayoutDeviceIntPoint::Round(aPoint * GetDesktopToDeviceScale());
+  if (mWindowType == WindowType::TopLevel ||
+      mWindowType == WindowType::Dialog) {
+    SetSizeMode(nsSizeMode_Normal);
+  }
+  if (mBounds.IsEqualXY(tl.x, tl.y) && mWindowType != WindowType::Popup) {
+    return;
+  }
+  MoveInternal(tl.x, tl.y);
+  if (mId) {
+    WinRegione s = {mId, (unsigned int)std::max(tl.x.value, 0),
+                    (unsigned int)std::max(tl.y.value, 0), 0, 0};
+    exos::Manda(WIN_MSG_SPOSTA, &s, sizeof(s));
+  }
+}
+
+void nsWindow::MoveInternal(int32_t aX, int32_t aY) {
+  if (mBounds.IsEqualXY(aX, aY)) {
+    return;
+  }
+  mBounds.MoveTo(aX, aY);
+  NotifyWindowMoved(mBounds.TopLeft());
+}
+
+void nsWindow::Resize(const DesktopSize& aSize, bool aRepaint) {
+  int32_t w = NSToIntRound(aSize.width);
+  int32_t h = NSToIntRound(aSize.height);
+  DIARIO("Resize %p %dx%d", this, w, h);
+  ConstrainSize(&w, &h);
+  ResizeInternal(w, h);
+  if (mId && (w != mZonaW || h != mZonaH)) {
+    WinRegione m = {mId, 0, 0, (unsigned int)std::max(w, 1),
+                    (unsigned int)std::max(h, 1)};
+    exos::Manda(WIN_MSG_MISURA, &m, sizeof(m));
+  }
+}
+
+void nsWindow::Resize(const DesktopRect& aRect, bool aRepaint) {
+  Move(aRect.TopLeft());
+  Resize(aRect.Size(), aRepaint);
+}
+
+void nsWindow::ResizeInternal(int32_t aWidth, int32_t aHeight) {
+  if (mBounds.Width() == aWidth && mBounds.Height() == aHeight) {
+    return;
+  }
+  mBounds.SizeTo(LayoutDeviceIntSize(aWidth, aHeight));
+  if (mCompositorWidgetDelegate) {
+    mCompositorWidgetDelegate->NotifyClientSizeChanged(mBounds.Size());
+  }
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mBounds.Size());
+  }
+  if (mAttachedWidgetListener) {
+    mAttachedWidgetListener->WindowResized(this, mBounds.Size());
+  }
+}
+
+void nsWindow::SetSizeMode(nsSizeMode aMode) {
+  if (aMode == mSizeMode) {
+    return;
+  }
+  mSizeMode = aMode;
+  ApplySizeModeSideEffects();
+}
+
+void nsWindow::ApplySizeModeSideEffects() {
+  if (!mVisible || mEffectiveSizeMode == mSizeMode) {
+    return;
+  }
+  if (mEffectiveSizeMode == nsSizeMode_Normal) {
+    mRestoreBounds = mBounds;
+  }
+
+  int32_t sw, sh;
+  Schermo(&sw, &sh);
+  switch (mSizeMode) {
+    case nsSizeMode_Normal:
+      Move(DesktopPoint(mRestoreBounds.X(), mRestoreBounds.Y()));
+      Resize(DesktopSize(mRestoreBounds.Width(), mRestoreBounds.Height()),
+             true);
+      break;
+    case nsSizeMode_Minimized:
+      if (mId) {
+        WinRegione r = {mId, 0, 0, 0, 0};
+        exos::Manda(WIN_MSG_RIDUCI, &r, sizeof(r));
+      }
+      break;
+    case nsSizeMode_Maximized:
+    case nsSizeMode_Fullscreen:
+      MoveInternal(kBordo, kBarra + kBordo);
+      if (mId) {
+        WinRegione s = {mId, (unsigned int)kBordo,
+                        (unsigned int)(kBarra + kBordo), 0, 0};
+        exos::Manda(WIN_MSG_SPOSTA, &s, sizeof(s));
+      }
+      Resize(DesktopSize(sw - 2 * kBordo, sh - kBarra - 2 * kBordo), true);
+      break;
+    default:
+      break;
+  }
+
+  mEffectiveSizeMode = mSizeMode;
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+}
+
+nsresult nsWindow::SetTitle(const nsAString& aTitle) {
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < aTitle.Length() && n + 1 < sizeof(mTitolo); i++) {
+    char16_t ch = aTitle[i];
+    if (ch == 0x2013 || ch == 0x2014) {
+      ch = '-';
+    }
+    mTitolo[n++] = (ch >= 32 && ch < 127) ? (char)ch : '?';
+  }
+  mTitolo[n] = '\0';
+  DIARIO("titolo '%s' (%u ms)", mTitolo, (unsigned)uptime_ms());
+  if (mId) {
+    WinTitolo t;
+    memset(&t, 0, sizeof(t));
+    t.id = mId;
+    memcpy(t.titolo, mTitolo, WIN_TITOLO_LEN - 1);
+    exos::Manda(WIN_MSG_TITOLO, &t, sizeof(t));
+  }
+  return NS_OK;
+}
