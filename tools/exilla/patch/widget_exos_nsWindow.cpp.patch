+class ExosTastiera final : public TextEventDispatcherListener {
+ public:
+  explicit ExosTastiera(nsWindow* aWidget) : mWidget(aWidget) {}
+
+  NS_DECL_ISUPPORTS
+
+  NS_IMETHOD NotifyIME(TextEventDispatcher*, const IMENotification&) override {
+    return NS_OK;
+  }
+  NS_IMETHOD_(IMENotificationRequests) GetIMENotificationRequests() override {
+    return IMENotificationRequests{};
+  }
+  NS_IMETHOD_(void) OnRemovedFrom(TextEventDispatcher*) override {}
+  NS_IMETHOD_(void)
+  WillDispatchKeyboardEvent(TextEventDispatcher*, WidgetKeyboardEvent&,
+                            uint32_t, void*) override {}
+
+  void Spegni() { mWidget = nullptr; }
+
+ private:
+  ~ExosTastiera() = default;
+  nsWindow* mWidget;
+};
+
+NS_IMPL_ISUPPORTS(ExosTastiera, TextEventDispatcherListener,
+                  nsISupportsWeakReference)
+
