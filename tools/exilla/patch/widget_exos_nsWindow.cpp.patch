+// The frame the server draws around a top-level window (wserver.c: BORDO and
+// BARRA_H). Not in the protocol: the client area is what we are given.
+static const int32_t kBordo = 2;
+static const int32_t kBarra = 20;
+
+already_AddRefed<nsIWidget> nsIWidget::CreateTopLevelWindow() {
+  nsCOMPtr<nsIWidget> window = new nsWindow();
+  return window.forget();
+}
