+
+/* EX-OS (Exilla): drawing in software, fonts through FreeType. The font list
+ * is gfxFT2FontList, the same Android uses: it reads font files from a
+ * directory, with no fontconfig underneath. */
+
+#ifndef GFX_PLATFORM_EXOS_H
+#define GFX_PLATFORM_EXOS_H
+
+#include "gfxPlatform.h"
+
+class gfxExosPlatform final : public gfxPlatform {
+ public:
+  gfxExosPlatform();
+  virtual ~gfxExosPlatform();
+
+  static gfxExosPlatform* GetPlatform() {
+    return (gfxExosPlatform*)gfxPlatform::GetPlatform();
+  }
+
+  already_AddRefed<gfxASurface> CreateOffscreenSurface(
+      const IntSize& aSize, gfxImageFormat aFormat) override;
+
+  gfxImageFormat GetOffscreenFormat() override {
+    return mozilla::gfx::SurfaceFormat::X8R8G8B8_UINT32;
+  }
+
+  bool CreatePlatformFontList() override;
+
+  void ReadSystemFontList(mozilla::dom::SystemFontList*) override;
+
+  void GetCommonFallbackFonts(uint32_t aCh, Script aRunScript,
+                              FontPresentation aPresentation,
+                              nsTArray<const char*>& aFontList) override;
+
+  already_AddRefed<mozilla::gfx::VsyncSource> CreateGlobalHardwareVsyncSource()
+      override;
+
+  static bool CheckVariationFontSupport() { return true; }
+};
+
+#endif /* GFX_PLATFORM_EXOS_H */
