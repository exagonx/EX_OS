+
+#include "nsAppShell.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "ExosPosta.h"
+#include "HeadlessScreenHelper.h"
+#include "gfxPlatform.h"
+#include "mozilla/widget/Screen.h"
+#include "mozilla/widget/ScreenManager.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+namespace {
+
+class ExosScreenHelper final : public ScreenManager::Helper {
+ public:
+  ExosScreenHelper() {
+    VideoInfo v;
+    if (video_info(&v) != 0 || !v.larghezza || !v.altezza) {
+      v.larghezza = 1024;
+      v.altezza = 768;
+    }
+    LayoutDeviceIntRect rect(0, 0, (int32_t)v.larghezza, (int32_t)v.altezza);
+    AutoTArray<RefPtr<Screen>, 1> screens;
+    screens.AppendElement(MakeRefPtr<Screen>(
+        rect, rect, 24, 24, 0, DesktopToLayoutDeviceScale(),
+        CSSToLayoutDeviceScale(), 96.0f, Screen::IsPseudoDisplay::No,
+        Screen::IsHDR::No, 80.0f, 1000.0f));
+    ScreenManager::Refresh(std::move(screens));
+  }
+};
+
+}  // namespace
+
+nsresult nsAppShell::Init() {
+  if (getenv("EXILLA_DIAG")) {
+    fprintf(stderr, "exilla: appshell init (pid %d, born at %u ms, now %u ms)\n",
+            (int)getpid(), (unsigned)exos::Nato(), (unsigned)exos::Ora());
+  }
+  exos::PrendiSveglia();
+  ScreenManager& screenManager = ScreenManager::GetSingleton();
+  if (gfxPlatform::IsHeadless()) {
+    screenManager.SetHelper(MakeUnique<HeadlessScreenHelper>());
+  } else {
+    screenManager.SetHelper(MakeUnique<ExosScreenHelper>());
+  }
+  return nsBaseAppShell::Init();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() { exos::Sveglia(); }
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  if (exos::PrendiSveglia()) {
+    NativeEventCallback();
+    return true;
+  }
+  bool fatto = exos::Ricevi(aMayWait);
+  if (exos::PrendiSveglia()) {
+    NativeEventCallback();
+    fatto = true;
+  }
+  return fatto;
+}
