+/* EX-OS (Exilla): the system locale is $LANG (it_IT.UTF-8 -> it-IT), as on
+ * Linux without a desktop. Date and time patterns are left to ICU. */
+
+#include "OSPreferences.h"
+
+#include "prenv.h"
+
+using namespace mozilla::intl;
+
+OSPreferences::OSPreferences() = default;
+
+bool OSPreferences::ReadSystemLocales(nsTArray<nsCString>& aLocaleList) {
+  const char* lang = PR_GetEnv("LANG");
+  if (!lang || !*lang || !strcmp(lang, "C") || !strcmp(lang, "POSIX")) {
+    return false;
+  }
+
+  nsAutoCString locale(lang);
+  int32_t cut = locale.FindChar('.');
+  if (cut >= 0) {
+    locale.Truncate(cut);
+  }
+  cut = locale.FindChar('@');
+  if (cut >= 0) {
+    locale.Truncate(cut);
+  }
+  locale.ReplaceChar('_', '-');
+  if (locale.IsEmpty()) {
+    return false;
+  }
+  aLocaleList.AppendElement(locale);
+  return true;
+}
+
+bool OSPreferences::ReadRegionalPrefsLocales(nsTArray<nsCString>& aLocaleList) {
+  return ReadSystemLocales(aLocaleList);
+}
+
+bool OSPreferences::ReadDateTimePattern(DateTimeFormatStyle aDateStyle,
+                                        DateTimeFormatStyle aTimeStyle,
+                                        const nsACString& aLocale,
+                                        nsACString& aRetVal) {
+  return false;
+}
+
+void OSPreferences::RemoveObservers() {}
