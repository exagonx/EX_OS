--- a/dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp
+++ b/dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp
@@ -11,12 +11,39 @@
 #endif
 #include "PlatformDecoderModule.h"
 #include "prlink.h"
+#include <string.h>
 #ifdef MOZ_WIDGET_GTK
 #  include "VALibWrapper.h"
 #  include "mozilla/gfx/gfxVars.h"
 #  include "mozilla/widget/DMABufDevice.h"
 #endif
 
+#ifdef XP_EXOS
+// EX-OS (Exilla): ffvpx is linked in, and FFVPXRuntimeLinker hands this
+// wrapper the handle (PRLibrary*)1: its symbols are the program's own. Weak,
+// so that what is not built reads NULL, exactly what PR_FindSymbol says for a
+// missing symbol. Any other handle is a real library opened by
+// FFmpegRuntimeLinker with dlopen (lib/libc_dl.c, 3 November 2026: the
+// system's FFmpeg, libavcodec.so.63, for H.264 and AAC), and goes to NSPR.
+extern "C" {
+#  define X(n) extern char exos_ff_##n __asm__(#n) __attribute__((weak));
+#  include "ffvpx/ffvpx_simboli_exos.inc"
+#  undef X
+}
+static void* ExosSimbolo(const char* aNome) {
+#  define X(n) \
+    if (!strcmp(aNome, #n)) return (void*)&exos_ff_##n;
+#  include "ffvpx/ffvpx_simboli_exos.inc"
+#  undef X
+  return nullptr;
+}
+#  define EXOS_FFVPX_DENTRO(aLib) ((aLib) == reinterpret_cast<PRLibrary*>(1))
+#  define PR_FindSymbol(aLib, aNome) \
+    (EXOS_FFVPX_DENTRO(aLib) ? ExosSimbolo(aNome) : PR_FindSymbol(aLib, aNome))
+#  define PR_UnloadLibrary(aLib) \
+    (EXOS_FFVPX_DENTRO(aLib) ? PR_SUCCESS : PR_UnloadLibrary(aLib))
+#endif
+
 #define AV_LOG_QUIET -8
 #define AV_LOG_PANIC 0
 #define AV_LOG_FATAL 8
