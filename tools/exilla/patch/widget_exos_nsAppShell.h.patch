+/* EX-OS (Exilla): the application shell. The main thread sleeps in the
+ * kernel waiting for IPC mail: the events of the ExWin windows, and the
+ * letters other threads send to wake it up (see ExosPosta.h). */
+
+#ifndef widget_exos_nsAppShell_h
+#define widget_exos_nsAppShell_h
+
+#include "nsBaseAppShell.h"
+
+class nsAppShell : public nsBaseAppShell {
+ public:
+  nsAppShell() = default;
+
+  nsresult Init();
+
+ protected:
+  virtual ~nsAppShell() = default;
+
+  void ScheduleNativeEventCallback() override;
+  bool ProcessNextNativeEvent(bool aMayWait) override;
+};
+
+#endif  // widget_exos_nsAppShell_h
