+
+/* EX-OS (Exilla): the application shell. In this first stage every window is
+ * a HeadlessWidget, so the only "native" event is Gecko asking to be woken
+ * up: a flag under a mutex, and a condition variable to sleep on. When the
+ * windows move into ExWin, ExWin's messages will arrive here too. */
+
+#ifndef widget_exos_nsAppShell_h
+#define widget_exos_nsAppShell_h
+
+#include <pthread.h>
+
+#include "nsBaseAppShell.h"
+
+class nsAppShell : public nsBaseAppShell {
+ public:
+  nsAppShell();
+
+  nsresult Init();
+
+ protected:
+  virtual ~nsAppShell();
+
+  void ScheduleNativeEventCallback() override;
+  bool ProcessNextNativeEvent(bool aMayWait) override;
+
+ private:
+  pthread_mutex_t mLock;
+  pthread_cond_t mWake;
+  bool mPending;
+};
+
+#endif  // widget_exos_nsAppShell_h
