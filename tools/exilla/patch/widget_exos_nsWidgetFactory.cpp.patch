+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsWidgetFactory.h"
+
+#include "mozilla/Components.h"
+#include "mozilla/WidgetUtils.h"
+#include "nsISupports.h"
+
+#include "nsAppShell.h"
+#include "nsAppShellSingleton.h"
+#include "nsLookAndFeel.h"
+
+#include "HeadlessClipboard.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+// EX-OS has no system clipboard yet: the headless one keeps it in memory.
+NS_IMPL_COMPONENT_FACTORY(nsIClipboard) {
+  nsCOMPtr<nsIClipboard> inst = new HeadlessClipboard();
+
+  return inst.forget();
+}
+
+nsresult nsWidgetExosModuleCtor() { return nsAppShellInit(); }
+
+void nsWidgetExosModuleDtor() {
+  WidgetUtils::Shutdown();
+  nsLookAndFeel::Shutdown();
+  nsAppShellShutdown();
+}
