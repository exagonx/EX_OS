# tools/exilla/mozconfig-js64 - the SpiderMonkey shell for 64-bit EX-OS, the
# first step of Exilla at 64 bit (16 October 2026). Used by
# EXOS_ARCH=x86_64 tools/exilla/js-costruisci.sh. Same choices as mozconfig-js.
#
# ! SENZA JIT E SENZA ICU, per cominciare: l'interprete si porta ovunque, e
# l'internazionalizzazione (ICU, dati da decine di MB) e' una tappa a parte.
ac_add_options --enable-project=js
ac_add_options --target=x86_64-unknown-exos
ac_add_options --disable-jit
ac_add_options --without-intl-api
ac_add_options --disable-tests
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-bootstrap
ac_add_options --disable-jemalloc
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../cross_build/exilla-obj/js64
ac_add_options --without-system-zlib
ac_add_options --disable-shared-js
ac_add_options --enable-nspr-build
