+/* VOCE 24 (kernel 0.334). With the kernel's lock: only the scheduler calls
+ * it, from runq_add. The two ICR writes with interrupts off, as above. */
+void smp_chiama(uint32_t c)
+{
+    int       apic;
+    uintptr_t flag;
+    uint32_t  giri = 100000;
+
+    if (!g_smp_lavora || g_apic == 0) return;
+    apic = apic_del_numero(c);
+    if (apic < 0) return;
+    flag = read_eflags();
+    interrupts_disable();
+    apic_scrivi(APIC_ICR_ALTO, (uint32_t)apic << 24);
+    apic_scrivi(APIC_ICR_BASSO, VETTORE_MESSAGGIO);
+    while ((apic_leggi(APIC_ICR_BASSO) & ICR_IN_VOLO) && --giri)
+        __asm__ volatile ("pause");
+    if (flag & 0x200u) interrupts_enable();
+}
