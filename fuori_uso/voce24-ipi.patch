+/* =============================================================================
+ * VOCE 24 (kernel 0.334): A PROCESS MADE READY CALLS AN IDLE PROCESSOR
+ *
+ * A processor in hlt looked at the queue again only at its next tick: up to
+ * 10 ms lost by every answer of a server whose threads sleep and wake. Now
+ * runq_add sends a message to the first other processor that is idle and may
+ * run p; smp_ap_irq calls sched_messaggio_cpu there, which chooses. Its
+ * g_corrente stays the idle task until it has the kernel's lock again, so
+ * reading it here, with the lock, is safe. Nothing with one processor.
+ * ============================================================================= */
+static Process *sched_pick_next(void);
+static void     sched_switch_to(Process *next);
+
+static void sched_chiama_ozio(const Process *p)
+{
+    uint32_t n, c, me;
+
+    if (!g_smp_lavora || g_sched_stopped) return;
+    n  = smp_al_lavoro();
+    me = cpu_n();
+    for (c = 0; c < n && c < g_cpu_posti; c++) {
+        if (c == me || g_ozio[c] == NULL || g_corrente[c] != g_ozio[c]) continue;
+        if (!sched_va_su(p, c)) continue;
+        smp_chiama(c);
+        return;
+    }
+}
+
+void sched_messaggio_cpu(void)
+{
+    Process *next;
+
+    if (g_sched_stopped || !g_smp_lavora || g_current == NULL) return;
+    if (g_current != g_idle_task) return;
+    next = sched_pick_next();
+    if (next != g_current) sched_switch_to(next);
+}
